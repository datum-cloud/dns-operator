#!/bin/sh
# Clearing enable files before stopping processes prevents automatic restart.
set -eu
rm -f /run/internal-dns/allow-named /run/internal-dns/allow-dnsdist
pkill -TERM -x named || true
pkill -TERM -x dnsdist || true
for daemon in named dnsdist; do
  for attempt in $(seq 1 40); do
    if ! pgrep -x "$daemon" >/dev/null; then break; fi
    sleep 0.05
  done
  if pgrep -x "$daemon" >/dev/null; then
    pkill -KILL -x "$daemon" || true
  fi
  if pgrep -x "$daemon" >/dev/null; then
    echo "DNS process did not stop: $daemon" >&2
    exit 1
  fi
done
