apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingWebhookConfiguration
metadata:
  name: internal-dns-e2e
webhooks:
  - name: internal-dns.dns.networking.miloapis.com
    admissionReviewVersions: [v1]
    sideEffects: None
    failurePolicy: Fail
    timeoutSeconds: 5
    matchPolicy: Equivalent
    clientConfig:
      url: https://host.docker.internal:9443/validate-internal-dns
      caBundle: ${CA_BUNDLE}
    rules:
      - operations: [CREATE, UPDATE, DELETE]
        apiGroups: [dns.networking.miloapis.com]
        apiVersions: [v1alpha1]
        resources:
          - dnszoneassociations
          - dnsregistrations
          - dnscontributiongrants
          - dnsrecordcontributions
          - dnsrecordcontributions/status
          - dnsnamingpolicies
          - dnsmanagednamespaces
          - dnsresolvercontexts
          - dnsresolvercontexts/status
          - dnsresolveraccessbindings
          - dnsresolveraccessbindings/status
          - dnsresolverbindings
          - dnspublicationownerships
          - dnspublicationmanifests
          - dnspublicationchunks
          - dnstransportoutboxes
